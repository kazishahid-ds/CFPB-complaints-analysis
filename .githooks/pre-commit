#!/bin/sh

protected_files="data/complaints.csv data/processed/credit_card_dataset.parquet"
max_bytes=95000000

for protected_file in $protected_files; do
  if git diff --cached --name-only --diff-filter=ACMR | grep -Fx "$protected_file" >/dev/null 2>&1; then
    echo "ERROR: $protected_file is staged and cannot be committed."
    echo "Remove it from the index before committing:"
    echo "  git restore --staged $protected_file"
    exit 1
  fi
done

git diff --cached --name-only --diff-filter=AM | while IFS= read -r path; do
  [ -z "$path" ] && continue

  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_bytes" ]; then
    echo "ERROR: $path is too large to commit ($size bytes)."
    echo "Keep large data artifacts out of git or use dedicated large-file storage."
    exit 1
  fi
done

exit 0